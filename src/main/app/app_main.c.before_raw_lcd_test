/*
 * TEST 2: LCD + MIPI-DSI + LVGL HISTORY, GT911 TOUCH NEVER INITIALIZED
 * ===================================================================
 *
 * Comparator:
 *   TEST 0 minimal baseline                  ~= 41.6 mA final Deep-sleep
 *   TEST 1 display + touch history           ~= 55.5 mA final Deep-sleep
 *   full normal application                  ~= 57.7 mA final Deep-sleep
 *
 * This test isolates the LCD/MIPI/LVGL side from the GT911 initialization
 * history. The flash script temporarily patches the Waveshare BSP so that
 * bsp_display_start() skips bsp_display_indev_init(). Thus:
 *
 *   - LCD/JD9365 initializes
 *   - MIPI DSI PHY + DSI bus initialize
 *   - LVGL display stack initializes
 *   - GT911 driver is NEVER created
 *   - GT911 full-sleep command is NOT sent
 *
 * This deliberately leaves GT911 untouched, matching the minimal baseline
 * more closely than Test 1.
 */

static const char *TAG = "LCD_ONLY_DS_TEST";

#define DISPLAY_ACTIVE_SETTLE_MS 2000U
#define PRE_SLEEP_MEASURE_MS     10000U
#define UART_QUIET_MS            500U

static int wait_for_level(gpio_num_t pin, int expected)
{
    for (unsigned i = 0; i < 20U; ++i) {
        const int level = gpio_get_level(pin);
        if (level == expected) {
            return level;
        }
        vTaskDelay(pdMS_TO_TICKS(10));
    }
    return gpio_get_level(pin);
}

static esp_err_t held_output(
    gpio_num_t pin,
    int level,
    gpio_pullup_t pull_up,
    gpio_pulldown_t pull_down,
    const char *name)
{
    esp_err_t ret = gpio_hold_dis(pin);
    if (ret != ESP_OK && ret != ESP_ERR_NOT_SUPPORTED) {
        ESP_LOGW(TAG, "%s: previous hold release on GPIO%d returned %s",
                 name, (int)pin, esp_err_to_name(ret));
    }

    const gpio_config_t cfg = {
        .pin_bit_mask = 1ULL << pin,
        .mode = GPIO_MODE_INPUT_OUTPUT,
        .pull_up_en = pull_up,
        .pull_down_en = pull_down,
        .intr_type = GPIO_INTR_DISABLE,
    };

    ret = gpio_config(&cfg);
    if (ret != ESP_OK) {
        return ret;
    }

    ret = gpio_set_level(pin, level);
    if (ret != ESP_OK) {
        return ret;
    }

    ret = gpio_sleep_sel_dis(pin);
    if (ret != ESP_OK) {
        return ret;
    }

    ret = gpio_hold_en(pin);
    if (ret != ESP_OK) {
        return ret;
    }

    const int readback = wait_for_level(pin, level);
    ESP_LOGI(TAG, "%s: GPIO%d=%d expected=%d hold=ON",
             name, (int)pin, readback, level);

    return readback == level ? ESP_OK : ESP_ERR_INVALID_STATE;
}

static esp_err_t float_input_no_pull(gpio_num_t pin)
{
    esp_err_t ret = gpio_hold_dis(pin);
    if (ret != ESP_OK && ret != ESP_ERR_NOT_SUPPORTED) {
        ESP_LOGW(TAG, "GPIO%d previous hold release returned %s",
                 (int)pin, esp_err_to_name(ret));
    }

    const gpio_config_t cfg = {
        .pin_bit_mask = 1ULL << pin,
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_DISABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };

    ret = gpio_config(&cfg);
    if (ret != ESP_OK) {
        return ret;
    }

    return gpio_sleep_sel_dis(pin);
}

static void quiesce_board_control_rails(void)
{
    ESP_ERROR_CHECK(held_output(
        APP_PWR_WIFI_C6_CHIP_PU_GPIO,
        APP_PWR_WIFI_C6_DISABLED_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_ENABLE,
        "ESP32-C6 CHIP_PU"));

    ESP_ERROR_CHECK(held_output(
        APP_PWR_ETHERNET_PHY_RESET_GPIO,
        APP_PWR_ETHERNET_RESET_ACTIVE_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_DISABLE,
        "Ethernet PHY RESET"));

    ESP_ERROR_CHECK(held_output(
        APP_PWR_AUDIO_AMP_GPIO,
        APP_PWR_AUDIO_AMP_DISABLED_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_DISABLE,
        "NS4150B amplifier EN"));

    ESP_ERROR_CHECK(held_output(
        APP_PWR_SDCARD_POWER_GPIO,
        APP_PWR_SDCARD_POWER_OFF_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_DISABLE,
        "microSD power gate"));
}

static void release_unused_signal_pins(void)
{
#if APP_PWR_ISOLATE_SDMMC_PINS
    static const int sdmmc_pins[] = APP_PWR_SDMMC_PIN_LIST;
    for (size_t i = 0; i < sizeof(sdmmc_pins) / sizeof(sdmmc_pins[0]); ++i) {
        ESP_ERROR_CHECK(float_input_no_pull((gpio_num_t)sdmmc_pins[i]));
    }
#endif

    ESP_ERROR_CHECK(float_input_no_pull(APP_PWR_SHARED_I2C_SDA_GPIO));
    ESP_ERROR_CHECK(float_input_no_pull(APP_PWR_SHARED_I2C_SCL_GPIO));

#if APP_PWR_QUIESCE_PERIPHERAL_SIGNAL_PINS
    static const int peripheral_pins[] = APP_PWR_PERIPHERAL_SIGNAL_PIN_LIST;
    for (size_t i = 0;
         i < sizeof(peripheral_pins) / sizeof(peripheral_pins[0]);
         ++i) {
        ESP_ERROR_CHECK(float_input_no_pull((gpio_num_t)peripheral_pins[i]));
    }
#endif
}

static void configure_gpio3_only_wakeup(void)
{
    const gpio_num_t wake_pin = APP_DEEP_SLEEP_BUTTON_GPIO;

    const gpio_config_t wake_cfg = {
        .pin_bit_mask = 1ULL << wake_pin,
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };
    ESP_ERROR_CHECK(gpio_config(&wake_cfg));

    if (!esp_sleep_is_valid_wakeup_gpio(wake_pin)) {
        ESP_LOGE(TAG, "GPIO%d is not valid for Deep-sleep wake", (int)wake_pin);
        ESP_ERROR_CHECK(ESP_ERR_INVALID_ARG);
    }

    while (gpio_get_level(wake_pin) == 0) {
        ESP_LOGW(TAG, "Release GPIO%d wake button to continue", (int)wake_pin);
        vTaskDelay(pdMS_TO_TICKS(100));
    }

    const esp_err_t clear_ret =
        esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_ALL);
    if (clear_ret != ESP_OK && clear_ret != ESP_ERR_INVALID_STATE) {
        ESP_ERROR_CHECK(clear_ret);
    }

    ESP_ERROR_CHECK(
        esp_deep_sleep_enable_gpio_wakeup(
            1ULL << wake_pin,
            ESP_GPIO_WAKEUP_GPIO_LOW));

    ESP_LOGI(TAG, "GPIO%d configured as the ONLY Deep-sleep wake source",
             (int)wake_pin);
}

static void detach_uart0(void)
{
#if APP_PWR_FLOAT_UART0_AT_FINAL_BOUNDARY
    static const int uart0_pins[] = APP_PWR_UART0_PIN_LIST;
    for (size_t i = 0; i < sizeof(uart0_pins) / sizeof(uart0_pins[0]); ++i) {
        (void)float_input_no_pull((gpio_num_t)uart0_pins[i]);
    }
#endif
}

static void run_lcd_mipi_history_test(void)
{
    ESP_LOGW(
        TAG,
        "TEST2 PHASE A: initialize LCD/MIPI/LVGL; BSP patch MUST skip GT911");

    lv_display_t *display = display_platform_start();
    if (display == NULL) {
        ESP_LOGE(TAG, "display_platform_start() failed");
        ESP_ERROR_CHECK(ESP_FAIL);
    }

    vTaskDelay(pdMS_TO_TICKS(150));

    /*
     * The temporary BSP patch used by the flash script must leave the BSP
     * input-device pointer NULL. If it is not NULL, this is not a valid Test 2.
     */
    lv_indev_t *touch = display_platform_get_input_device();
    if (touch != NULL) {
        ESP_LOGE(
            TAG,
            "INVALID TEST2: GT911/LVGL input device exists; refusing measurement");
        ESP_ERROR_CHECK(ESP_ERR_INVALID_STATE);
    }

    ESP_LOGI(
        TAG,
        "TEST2 VERIFIED: GT911 input device is NULL; touch was not initialized");

    display_platform_disable_lvgl_overlays(display);
    display_platform_backlight_on();

    ESP_LOGW(
        TAG,
        "TEST2 LCD/MIPI-ACTIVE window: %u ms",
        (unsigned)DISPLAY_ACTIVE_SETTLE_MS);
    vTaskDelay(pdMS_TO_TICKS(DISPLAY_ACTIVE_SETTLE_MS));

    ESP_LOGW(TAG, "TEST2 PHASE B: panel DISPLAY_OFF + SLEEP_IN");
    const esp_err_t panel_ret =
        component_display_panel_enter_full_sleep();
    ESP_LOGI(TAG, "panel full-sleep result=%s", esp_err_to_name(panel_ret));

    ESP_LOGW(TAG, "TEST2 PHASE C: BSP LVGL/MIPI-DSI/display teardown");
    const esp_err_t transport_ret =
        bsp_display_shutdown_for_deep_sleep();
    ESP_LOGI(TAG, "display transport teardown result=%s",
             esp_err_to_name(transport_ret));

    /*
     * IMPORTANT: do NOT call component_display_disable_for_deep_sleep().
     * That function sends the GT911 full-Sleep command. Test 2 is specifically
     * meant to keep GT911 untouched, as in the minimal baseline.
     */
    ESP_LOGW(
        TAG,
        "TEST2 PHASE D: GT911 intentionally untouched "
        "(no driver init, no full-sleep command)");

    if (panel_ret != ESP_OK || transport_ret != ESP_OK) {
        ESP_LOGW(
            TAG,
            "LCD/MIPI shutdown reported an error; continuing to Deep-sleep "
            "so the electrical result remains measurable");
    }
}

void app_main(void)
{
    ESP_LOGW(TAG, "======================================================");
    ESP_LOGW(TAG, " TEST 2: LCD/MIPI/LVGL HISTORY, NO GT911 INIT");
    ESP_LOGW(TAG, " Baseline comparator: minimal firmware ~= 41.6 mA");
    ESP_LOGW(TAG, " TEST1 comparator: display+touch ~= 55.5 mA");
    ESP_LOGW(TAG, " Camera/AI/normal application are NOT started.");
    ESP_LOGW(TAG, "======================================================");

    quiesce_board_control_rails();

    run_lcd_mipi_history_test();

    quiesce_board_control_rails();
    release_unused_signal_pins();
    configure_gpio3_only_wakeup();

    ESP_LOGW(
        TAG,
        "TEST2 PRE-SLEEP measurement window: %u ms after LCD/MIPI teardown",
        (unsigned)PRE_SLEEP_MEASURE_MS);

    vTaskDelay(pdMS_TO_TICKS(PRE_SLEEP_MEASURE_MS));

    quiesce_board_control_rails();

    ESP_LOGW(
        TAG,
        "TEST2 entering TRUE ESP32-P4 Deep-sleep now. "
        "Compare final plateau with 41.6 mA baseline and 55.5 mA Test1.");

    fflush(stdout);

    detach_uart0();

    vTaskDelay(pdMS_TO_TICKS(UART_QUIET_MS));
    esp_deep_sleep_start();
}
