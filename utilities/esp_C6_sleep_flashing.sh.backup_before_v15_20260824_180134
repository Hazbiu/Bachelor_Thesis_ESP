#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
C6_PROJECT="$PROJECT_ROOT/c6_deep_sleep_firmware"
BACKUP_DIR="$PROJECT_ROOT/c6_factory_backups"
ACTION="${1:-}"
PORT="${2:-}"

usage() {
cat <<'TXT'
Usage:
  ./utilities/esp_C6_sleep_flashing.sh build
  ./utilities/esp_C6_sleep_flashing.sh probe   /dev/ttyUSB0
  ./utilities/esp_C6_sleep_flashing.sh backup  /dev/ttyUSB0
  ./utilities/esp_C6_sleep_flashing.sh flash   /dev/ttyUSB0
  ./utilities/esp_C6_sleep_flashing.sh monitor /dev/ttyUSB0
  ./utilities/esp_C6_sleep_flashing.sh restore /dev/ttyUSB0 /path/to/c6_factory_full_flash.bin

Programming wiring (3.3-V logic USB-to-TTL):
  TTL GND -> board GND
  TTL TX  -> C6_U0RXD
  TTL RX  -> C6_U0TXD
  Do NOT connect TTL 5V/VCC if the board is powered normally.

Before power-on for C6 ROM download mode:
  C6_IO9 -> GND
  Also hold the ESP32-P4 in download mode so its application cannot drive C6 reset.
TXT
}

need_idf() {
  command -v idf.py >/dev/null 2>&1 || { echo "[ERROR] idf.py unavailable"; exit 1; }
  python -m esptool version >/dev/null 2>&1 || { echo "[ERROR] esptool unavailable"; exit 1; }
}
need_port() {
  [[ -n "$PORT" ]] || { echo "[ERROR] port required"; usage; exit 2; }
  [[ -e "$PORT" ]] || { echo "[ERROR] no device: $PORT"; ls -l /dev/ttyUSB* /dev/ttyACM* 2>/dev/null || true; exit 1; }
}
prepare_target() {
  cd "$C6_PROJECT"
  if [[ -f sdkconfig ]] && grep -q 'CONFIG_IDF_TARGET="esp32c6"' sdkconfig; then return; fi
  rm -f sdkconfig sdkconfig.old
  rm -rf build
  idf.py set-target esp32c6
}
probe() {
  need_port
  python -m esptool --chip esp32c6 -p "$PORT" --before no_reset --after no_reset chip_id
  python -m esptool --chip esp32c6 -p "$PORT" --before no_reset --after no_reset flash_id
}
detect_bytes() {
  local out size n unit
  out="$(python -m esptool --chip esp32c6 -p "$PORT" --before no_reset --after no_reset flash_id 2>&1)"
  echo "$out" >&2
  size="$(printf '%s\n' "$out" | sed -nE 's/.*Detected flash size:[[:space:]]*([0-9]+)(MB|KB).*/\1 \2/p' | tail -1)"
  [[ -n "$size" ]] || return 1
  read -r n unit <<< "$size"
  if [[ "$unit" == MB ]]; then echo $((n*1024*1024)); else echo $((n*1024)); fi
}
backup() {
  need_port
  mkdir -p "$BACKUP_DIR"
  local bytes stamp out
  if [[ -n "${C6_FLASH_SIZE_MB:-}" ]]; then bytes=$((C6_FLASH_SIZE_MB*1024*1024)); else bytes="$(detect_bytes)"; fi
  stamp="$(date +%Y%m%d_%H%M%S)"
  out="$BACKUP_DIR/c6_factory_full_flash_${stamp}.bin"
  echo "[INFO] backing up $bytes bytes to $out"
  python -m esptool --chip esp32c6 -p "$PORT" --before no_reset --after no_reset read_flash 0x0 "$bytes" "$out"
  sha256sum "$out"
  echo "[OK] KEEP THIS BACKUP: $out"
}
build() {
  prepare_target
  idf.py build
}
flash() {
  need_port
  prepare_target
  [[ -f build/flash_args ]] || idf.py build
  python -m esptool --chip esp32c6 -p "$PORT" -b 460800 --before no_reset --after no_reset write_flash "@build/flash_args"
  echo "[OK] C6 flashed. Power OFF, remove C6_IO9-GND, release P4 BOOT, then power ON."
}
monitor() {
  need_port
  cd "$C6_PROJECT"
  idf.py -p "$PORT" monitor
}
restore() {
  need_port
  local img="${3:-}"
  [[ -f "$img" ]] || { echo "[ERROR] backup file required/found"; exit 2; }
  python -m esptool --chip esp32c6 -p "$PORT" -b 460800 --before no_reset --after no_reset write_flash 0x0 "$img"
  echo "[OK] raw factory C6 flash restored"
}

need_idf
case "$ACTION" in
  build) build ;;
  probe) probe ;;
  backup) backup ;;
  flash) flash ;;
  monitor) monitor ;;
  restore) restore "$@" ;;
  *) usage; exit 2 ;;
esac
