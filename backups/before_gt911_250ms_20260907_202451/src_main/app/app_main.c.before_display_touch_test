#include <stdio.h>

#include "driver/gpio.h"
#include "esp_err.h"
#include "esp_log.h"
#include "esp_sleep.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

#include "config/app_config.h"

/*
 * TEMPORARY MINIMAL ESP32-P4 DEEP-SLEEP DIAGNOSTIC
 * =================================================
 *
 * Purpose:
 *   Determine whether the ~58 mA final Deep-sleep floor comes from the normal
 *   face-recognition application state or from the board / external hardware.
 *
 * This build intentionally DOES NOT start:
 *   - application runtime
 *   - LVGL / MIPI-DSI
 *   - OV5647 camera pipeline
 *   - AI / TFLM / ESP-DL
 *   - SD filesystem
 *   - normal light/deep sleep manager
 *
 * It only:
 *   1. places simple board control GPIOs in their known low-power states;
 *   2. releases unused peripheral signal pins to input/no-pull;
 *   3. configures GPIO3 as the only Deep-sleep wake source;
 *   4. waits 10 s to give the Joulescope a visible pre-sleep plateau;
 *   5. detaches UART0 GPIO37/38;
 *   6. calls esp_deep_sleep_start().
 *
 * IMPORTANT:
 *   This is measurement firmware, not the normal application.
 */

static const char *TAG = "MIN_DEEP_TEST";

#define MIN_TEST_PRE_SLEEP_MS 10000U
#define MIN_TEST_UART_QUIET_MS 500U

static int wait_for_level(gpio_num_t pin, int expected)
{
    for (unsigned i = 0; i < 20U; ++i) {
        const int level = gpio_get_level(pin);
        if (level == expected) {
            return level;
        }
        vTaskDelay(pdMS_TO_TICKS(10));
    }
    return gpio_get_level(pin);
}

static esp_err_t held_output(
    gpio_num_t pin,
    int level,
    gpio_pullup_t pull_up,
    gpio_pulldown_t pull_down,
    const char *name)
{
    esp_err_t ret = gpio_hold_dis(pin);
    if (ret != ESP_OK && ret != ESP_ERR_NOT_SUPPORTED) {
        ESP_LOGW(TAG, "%s: previous hold release on GPIO%d returned %s",
                 name, (int)pin, esp_err_to_name(ret));
    }

    const gpio_config_t cfg = {
        .pin_bit_mask = 1ULL << pin,
        .mode = GPIO_MODE_INPUT_OUTPUT,
        .pull_up_en = pull_up,
        .pull_down_en = pull_down,
        .intr_type = GPIO_INTR_DISABLE,
    };

    ret = gpio_config(&cfg);
    if (ret != ESP_OK) {
        return ret;
    }

    ret = gpio_set_level(pin, level);
    if (ret != ESP_OK) {
        return ret;
    }

    /*
     * Keep the active GPIO configuration selected at the sleep boundary.
     * gpio_hold_en() is the same best-effort mechanism already used by the
     * project for these board control signals.
     */
    ret = gpio_sleep_sel_dis(pin);
    if (ret != ESP_OK) {
        return ret;
    }

    ret = gpio_hold_en(pin);
    if (ret != ESP_OK) {
        return ret;
    }

    const int readback = wait_for_level(pin, level);
    ESP_LOGI(TAG, "%s: GPIO%d=%d expected=%d hold=ON",
             name, (int)pin, readback, level);

    return readback == level ? ESP_OK : ESP_ERR_INVALID_STATE;
}

static esp_err_t float_input_no_pull(gpio_num_t pin)
{
    esp_err_t ret = gpio_hold_dis(pin);
    if (ret != ESP_OK && ret != ESP_ERR_NOT_SUPPORTED) {
        ESP_LOGW(TAG, "GPIO%d previous hold release returned %s",
                 (int)pin, esp_err_to_name(ret));
    }

    const gpio_config_t cfg = {
        .pin_bit_mask = 1ULL << pin,
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_DISABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };

    ret = gpio_config(&cfg);
    if (ret != ESP_OK) {
        return ret;
    }

    return gpio_sleep_sel_dis(pin);
}

static void quiesce_board_control_rails(void)
{
    /*
     * GPIO54 -> ESP32-C6 CHIP_PU
     * LOW keeps the C6 in reset while the P4 is still awake.
     *
     * The existing project has already measured that P4 rev-v1.3 may allow
     * GPIO54 to rise after the HP GPIO domain powers down. That behavior is
     * intentionally NOT hidden by this test: if C6 wakes at the true P4
     * Deep-sleep boundary, the Joulescope result must include it.
     */
    ESP_ERROR_CHECK(held_output(
        APP_PWR_WIFI_C6_CHIP_PU_GPIO,
        APP_PWR_WIFI_C6_DISABLED_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_ENABLE,
        "ESP32-C6 CHIP_PU"));

    /* GPIO51 LOW = IP101GRI Ethernet PHY held in hardware reset. */
    ESP_ERROR_CHECK(held_output(
        APP_PWR_ETHERNET_PHY_RESET_GPIO,
        APP_PWR_ETHERNET_RESET_ACTIVE_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_DISABLE,
        "Ethernet PHY RESET"));

    /* GPIO53 LOW = NS4150B amplifier disabled. */
    ESP_ERROR_CHECK(held_output(
        APP_PWR_AUDIO_AMP_GPIO,
        APP_PWR_AUDIO_AMP_DISABLED_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_DISABLE,
        "NS4150B amplifier EN"));

    /* GPIO45 HIGH = Q1 off, microSD SD1_VDD disconnected. */
    ESP_ERROR_CHECK(held_output(
        APP_PWR_SDCARD_POWER_GPIO,
        APP_PWR_SDCARD_POWER_OFF_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_DISABLE,
        "microSD power gate"));
}

static void release_unused_signal_pins(void)
{
#if APP_PWR_ISOLATE_SDMMC_PINS
    static const int sdmmc_pins[] = APP_PWR_SDMMC_PIN_LIST;
    for (size_t i = 0; i < sizeof(sdmmc_pins) / sizeof(sdmmc_pins[0]); ++i) {
        ESP_ERROR_CHECK(float_input_no_pull((gpio_num_t)sdmmc_pins[i]));
    }
#endif

    /*
     * Shared I2C has physical 2.2 kOhm pull-ups on the board.
     * Make only the P4 side high-impedance; do not add internal pulls.
     */
    ESP_ERROR_CHECK(float_input_no_pull(APP_PWR_SHARED_I2C_SDA_GPIO));
    ESP_ERROR_CHECK(float_input_no_pull(APP_PWR_SHARED_I2C_SCL_GPIO));

#if APP_PWR_QUIESCE_PERIPHERAL_SIGNAL_PINS
    static const int peripheral_pins[] = APP_PWR_PERIPHERAL_SIGNAL_PIN_LIST;
    for (size_t i = 0;
         i < sizeof(peripheral_pins) / sizeof(peripheral_pins[0]);
         ++i) {
        ESP_ERROR_CHECK(float_input_no_pull((gpio_num_t)peripheral_pins[i]));
    }
#endif
}

static void configure_gpio3_only_wakeup(void)
{
    const gpio_num_t wake_pin = APP_DEEP_SLEEP_BUTTON_GPIO;

    const gpio_config_t wake_cfg = {
        .pin_bit_mask = 1ULL << wake_pin,
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };
    ESP_ERROR_CHECK(gpio_config(&wake_cfg));

    if (!esp_sleep_is_valid_wakeup_gpio(wake_pin)) {
        ESP_LOGE(TAG, "GPIO%d is not valid for Deep-sleep wake", (int)wake_pin);
        return;
    }

    /*
     * Avoid an immediate wake if the button is held while the test boots.
     */
    while (gpio_get_level(wake_pin) == 0) {
        ESP_LOGW(TAG, "Release GPIO%d wake button to continue", (int)wake_pin);
        vTaskDelay(pdMS_TO_TICKS(100));
    }

    const esp_err_t clear_ret =
        esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_ALL);
    if (clear_ret != ESP_OK && clear_ret != ESP_ERR_INVALID_STATE) {
        ESP_ERROR_CHECK(clear_ret);
    }

    ESP_ERROR_CHECK(
        esp_deep_sleep_enable_gpio_wakeup(
            1ULL << wake_pin,
            ESP_GPIO_WAKEUP_GPIO_LOW));

    ESP_LOGI(TAG, "GPIO%d configured as the ONLY Deep-sleep wake source",
             (int)wake_pin);
}

static void detach_uart0(void)
{
#if APP_PWR_FLOAT_UART0_AT_FINAL_BOUNDARY
    static const int uart0_pins[] = APP_PWR_UART0_PIN_LIST;
    for (size_t i = 0; i < sizeof(uart0_pins) / sizeof(uart0_pins[0]); ++i) {
        (void)float_input_no_pull((gpio_num_t)uart0_pins[i]);
    }
#endif
}

void app_main(void)
{
    ESP_LOGW(TAG, "======================================================");
    ESP_LOGW(TAG, " MINIMAL ESP32-P4 DEEP-SLEEP CURRENT DIAGNOSTIC");
    ESP_LOGW(TAG, " Normal face-recognition application is NOT starting.");
    ESP_LOGW(TAG, "======================================================");

    /*
     * Put the software-controllable board rails into known low-power states
     * before the Joulescope pre-sleep plateau.
     */
    quiesce_board_control_rails();
    release_unused_signal_pins();
    configure_gpio3_only_wakeup();

    ESP_LOGI(
        TAG,
        "PRE-SLEEP measurement window: %u ms. "
        "Record Joulescope statistics CSV now.",
        (unsigned)MIN_TEST_PRE_SLEEP_MS);

    vTaskDelay(pdMS_TO_TICKS(MIN_TEST_PRE_SLEEP_MS));

    /*
     * Re-assert control rails immediately before the irreversible boundary.
     * This removes any chance that the 10-second measurement window changed a
     * control pin.
     */
    quiesce_board_control_rails();

    ESP_LOGW(
        TAG,
        "Entering TRUE ESP32-P4 Deep-sleep now. "
        "Final current plateau is the value to compare with ~58 mA.");

    fflush(stdout);

    /*
     * Disconnect UART0 pins from the on-board USB-UART side before Deep-sleep.
     * No log calls are made after this point.
     */
    detach_uart0();

    vTaskDelay(pdMS_TO_TICKS(MIN_TEST_UART_QUIET_MS));
    esp_deep_sleep_start();

    /* Successful Deep-sleep entry never returns. */
}
