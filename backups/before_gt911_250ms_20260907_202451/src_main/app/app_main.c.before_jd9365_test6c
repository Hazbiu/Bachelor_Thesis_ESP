/*
 * TEST 6B: JD9365 + DBI + MIPI, BRIGHTNESS INIT SKIPPED,
 *          BUT BACKLIGHT FORCED OFF BEFORE MEASUREMENT
 * =================================================================
 *
 * Why 6B exists:
 * Test 6 proved the panel path ran, but its CSV stayed around ~0.5 A before
 * deep sleep and ~0.48 A immediately after deep sleep. That means the board
 * was not electrically comparable to the earlier low-current tests.
 *
 * Test 6B keeps the diagnostic isolation from Test 6:
 *   - bsp_display_brightness_init() is patched OUT
 *   - no LVGL
 *   - no GT911
 *
 * It still initializes:
 *   - MIPI DPHY
 *   - MIPI-DSI bus
 *   - DBI panel-I/O
 *   - JD9365 create/reset/init
 *
 * Critical normalization:
 *   - after JD9365 init, explicitly issue backlight/controller OFF
 *   - issue DISPLAY_OFF + SLEEP_IN
 *   - delete panel + DBI
 *   - delete DSI bus + release DPHY LDO
 *   - force backlight/controller OFF once more
 *   - float shared I2C pins exactly like the minimal baseline
 *
 * Test 4 already showed that exercising the display I2C/backlight controller
 * by itself does not reproduce the high deep-sleep plateau, so using the OFF
 * write here is a normalization step rather than a new candidate subsystem.
 */

static const char *TAG = "JD9365_6B_DS_TEST";

#define PRE_LCD_BASELINE_MS     2000U
#define PANEL_HISTORY_MS        1500U
#define BACKLIGHT_OFF_SETTLE_MS 2000U
#define POST_LCD_SHUTDOWN_MS    3000U
#define PRE_SLEEP_MEASURE_MS   10000U
#define UART_QUIET_MS            500U

extern esp_err_t bsp_test6b_mipi_cleanup_only(void);

static int wait_for_level(gpio_num_t pin, int expected)
{
    for (unsigned i = 0; i < 20U; ++i) {
        const int level = gpio_get_level(pin);
        if (level == expected) {
            return level;
        }
        vTaskDelay(pdMS_TO_TICKS(10));
    }
    return gpio_get_level(pin);
}

static esp_err_t held_output(
    gpio_num_t pin,
    int level,
    gpio_pullup_t pull_up,
    gpio_pulldown_t pull_down,
    const char *name)
{
    esp_err_t ret = gpio_hold_dis(pin);
    if (ret != ESP_OK && ret != ESP_ERR_NOT_SUPPORTED) {
        ESP_LOGW(TAG, "%s: previous hold release on GPIO%d returned %s",
                 name, (int)pin, esp_err_to_name(ret));
    }

    const gpio_config_t cfg = {
        .pin_bit_mask = 1ULL << pin,
        .mode = GPIO_MODE_INPUT_OUTPUT,
        .pull_up_en = pull_up,
        .pull_down_en = pull_down,
        .intr_type = GPIO_INTR_DISABLE,
    };

    ESP_RETURN_ON_ERROR(gpio_config(&cfg), TAG, "%s gpio_config failed", name);
    ESP_RETURN_ON_ERROR(gpio_set_level(pin, level), TAG, "%s level failed", name);
    ESP_RETURN_ON_ERROR(gpio_sleep_sel_dis(pin), TAG, "%s sleep_sel failed", name);
    ESP_RETURN_ON_ERROR(gpio_hold_en(pin), TAG, "%s hold failed", name);

    const int readback = wait_for_level(pin, level);
    ESP_LOGI(TAG, "%s: GPIO%d=%d expected=%d hold=ON",
             name, (int)pin, readback, level);

    return readback == level ? ESP_OK : ESP_ERR_INVALID_STATE;
}

static esp_err_t float_input_no_pull(gpio_num_t pin)
{
    esp_err_t ret = gpio_hold_dis(pin);
    if (ret != ESP_OK && ret != ESP_ERR_NOT_SUPPORTED) {
        ESP_LOGW(TAG, "GPIO%d previous hold release returned %s",
                 (int)pin, esp_err_to_name(ret));
    }

    const gpio_config_t cfg = {
        .pin_bit_mask = 1ULL << pin,
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_DISABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };

    ESP_RETURN_ON_ERROR(gpio_config(&cfg), TAG, "GPIO%d config failed", (int)pin);
    return gpio_sleep_sel_dis(pin);
}

static void quiesce_board_control_rails(void)
{
    ESP_ERROR_CHECK(held_output(
        APP_PWR_WIFI_C6_CHIP_PU_GPIO,
        APP_PWR_WIFI_C6_DISABLED_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_ENABLE,
        "ESP32-C6 CHIP_PU"));

    ESP_ERROR_CHECK(held_output(
        APP_PWR_ETHERNET_PHY_RESET_GPIO,
        APP_PWR_ETHERNET_RESET_ACTIVE_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_DISABLE,
        "Ethernet PHY RESET"));

    ESP_ERROR_CHECK(held_output(
        APP_PWR_AUDIO_AMP_GPIO,
        APP_PWR_AUDIO_AMP_DISABLED_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_DISABLE,
        "NS4150B amplifier EN"));

    ESP_ERROR_CHECK(held_output(
        APP_PWR_SDCARD_POWER_GPIO,
        APP_PWR_SDCARD_POWER_OFF_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_DISABLE,
        "microSD power gate"));
}

static void release_unused_signal_pins(void)
{
#if APP_PWR_ISOLATE_SDMMC_PINS
    static const int sdmmc_pins[] = APP_PWR_SDMMC_PIN_LIST;
    for (size_t i = 0; i < sizeof(sdmmc_pins) / sizeof(sdmmc_pins[0]); ++i) {
        ESP_ERROR_CHECK(float_input_no_pull((gpio_num_t)sdmmc_pins[i]));
    }
#endif

    ESP_ERROR_CHECK(float_input_no_pull(APP_PWR_SHARED_I2C_SDA_GPIO));
    ESP_ERROR_CHECK(float_input_no_pull(APP_PWR_SHARED_I2C_SCL_GPIO));

#if APP_PWR_QUIESCE_PERIPHERAL_SIGNAL_PINS
    static const int peripheral_pins[] = APP_PWR_PERIPHERAL_SIGNAL_PIN_LIST;
    for (size_t i = 0;
         i < sizeof(peripheral_pins) / sizeof(peripheral_pins[0]);
         ++i) {
        ESP_ERROR_CHECK(float_input_no_pull((gpio_num_t)peripheral_pins[i]));
    }
#endif
}

static void configure_gpio3_only_wakeup(void)
{
    const gpio_num_t wake_pin = APP_DEEP_SLEEP_BUTTON_GPIO;

    const gpio_config_t wake_cfg = {
        .pin_bit_mask = 1ULL << wake_pin,
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };
    ESP_ERROR_CHECK(gpio_config(&wake_cfg));

    if (!esp_sleep_is_valid_wakeup_gpio(wake_pin)) {
        ESP_LOGE(TAG, "GPIO%d is not valid for Deep-sleep wake", (int)wake_pin);
        ESP_ERROR_CHECK(ESP_ERR_INVALID_ARG);
    }

    while (gpio_get_level(wake_pin) == 0) {
        ESP_LOGW(TAG, "Release GPIO%d wake button to continue", (int)wake_pin);
        vTaskDelay(pdMS_TO_TICKS(100));
    }

    const esp_err_t clear_ret =
        esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_ALL);
    if (clear_ret != ESP_OK && clear_ret != ESP_ERR_INVALID_STATE) {
        ESP_ERROR_CHECK(clear_ret);
    }

    ESP_ERROR_CHECK(
        esp_deep_sleep_enable_gpio_wakeup(
            1ULL << wake_pin,
            ESP_GPIO_WAKEUP_GPIO_LOW));

    ESP_LOGI(TAG, "GPIO%d configured as the ONLY Deep-sleep wake source",
             (int)wake_pin);
}

static void detach_uart0(void)
{
#if APP_PWR_FLOAT_UART0_AT_FINAL_BOUNDARY
    static const int uart0_pins[] = APP_PWR_UART0_PIN_LIST;
    for (size_t i = 0; i < sizeof(uart0_pins) / sizeof(uart0_pins[0]); ++i) {
        (void)float_input_no_pull((gpio_num_t)uart0_pins[i]);
    }
#endif
}

static void run_test6b(void)
{
    esp_lcd_panel_handle_t panel = NULL;
    esp_lcd_panel_io_handle_t io = NULL;

    ESP_LOGW(TAG,
             "TEST6B BASELINE window: %u ms before JD9365/MIPI init",
             (unsigned)PRE_LCD_BASELINE_MS);
    vTaskDelay(pdMS_TO_TICKS(PRE_LCD_BASELINE_MS));

    ESP_LOGW(TAG,
             "TEST6B PHASE A: bsp_display_new() with brightness init PATCHED OUT");

    esp_err_t ret = bsp_display_new(NULL, &panel, &io);
    if (ret != ESP_OK || panel == NULL || io == NULL) {
        ESP_LOGE(TAG,
                 "TEST6B panel init failed: ret=%s panel=%p io=%p",
                 esp_err_to_name(ret), (void *)panel, (void *)io);
        ESP_ERROR_CHECK(ret != ESP_OK ? ret : ESP_FAIL);
    }

    ESP_LOGW(TAG,
             "TEST6B VERIFIED ACTIVE: JD9365 + DBI + MIPI created; "
             "brightness init skipped; NO LVGL/GT911");

    /* Preserve the initialization history, but do not leave the board at ~0.5 A. */
    vTaskDelay(pdMS_TO_TICKS(PANEL_HISTORY_MS));

    ESP_LOGW(TAG,
             "TEST6B PHASE B: FORCE BACKLIGHT/CONTROLLER OFF before panel sleep");
    ret = bsp_display_backlight_off();
    ESP_LOGI(TAG, "backlight OFF result=%s", esp_err_to_name(ret));
    ESP_ERROR_CHECK(ret);

    vTaskDelay(pdMS_TO_TICKS(BACKLIGHT_OFF_SETTLE_MS));

    ESP_LOGW(TAG, "TEST6B PHASE C: DISPLAY_OFF");
    ret = esp_lcd_panel_disp_on_off(panel, false);
    ESP_LOGI(TAG, "DISPLAY_OFF result=%s", esp_err_to_name(ret));
    ESP_ERROR_CHECK(ret);

    vTaskDelay(pdMS_TO_TICKS(20));

    ESP_LOGW(TAG, "TEST6B PHASE D: JD9365 SLEEP_IN");
    ret = esp_lcd_panel_disp_sleep(panel, true);
    ESP_LOGI(TAG, "SLEEP_IN result=%s", esp_err_to_name(ret));
    ESP_ERROR_CHECK(ret);

    vTaskDelay(pdMS_TO_TICKS(120));

    ESP_LOGW(TAG, "TEST6B PHASE E: delete JD9365 panel + DBI IO");
    ret = esp_lcd_panel_del(panel);
    ESP_LOGI(TAG, "panel delete result=%s", esp_err_to_name(ret));
    ESP_ERROR_CHECK(ret);
    panel = NULL;

    ret = esp_lcd_panel_io_del(io);
    ESP_LOGI(TAG, "DBI IO delete result=%s", esp_err_to_name(ret));
    ESP_ERROR_CHECK(ret);
    io = NULL;

    ESP_LOGW(TAG, "TEST6B PHASE F: delete DSI bus + release DPHY LDO");
    ret = bsp_test6b_mipi_cleanup_only();
    ESP_LOGI(TAG, "MIPI cleanup result=%s", esp_err_to_name(ret));
    ESP_ERROR_CHECK(ret);

    /*
     * Re-assert OFF after the transport is gone. This only exercises the same
     * display-side OFF control already cleared as a culprit by Test 4.
     */
    ESP_LOGW(TAG, "TEST6B PHASE G: re-assert backlight/controller OFF");
    ret = bsp_display_backlight_off();
    ESP_LOGI(TAG, "final backlight OFF result=%s", esp_err_to_name(ret));
    ESP_ERROR_CHECK(ret);

    ESP_LOGW(TAG,
             "TEST6B VERIFIED STOPPED: backlight OFF; JD9365/DBI/DSI deleted; "
             "DPHY LDO released");

    vTaskDelay(pdMS_TO_TICKS(POST_LCD_SHUTDOWN_MS));
}

void app_main(void)
{
    ESP_LOGW(TAG, "======================================================");
    ESP_LOGW(TAG, " TEST 6B: JD9365 HISTORY + NORMALIZED BACKLIGHT OFF");
    ESP_LOGW(TAG, " BRIGHTNESS INIT SKIPPED; NO LVGL; NO GT911");
    ESP_LOGW(TAG, " Minimal/Test5 clean region ~= 41.6 mA");
    ESP_LOGW(TAG, " Test3 raw display path ~= 61.2 mA");
    ESP_LOGW(TAG, "======================================================");

    quiesce_board_control_rails();

    run_test6b();

    quiesce_board_control_rails();
    release_unused_signal_pins();
    configure_gpio3_only_wakeup();

    ESP_LOGW(TAG,
             "TEST6B PRE-SLEEP measurement window: %u ms",
             (unsigned)PRE_SLEEP_MEASURE_MS);
    vTaskDelay(pdMS_TO_TICKS(PRE_SLEEP_MEASURE_MS));

    quiesce_board_control_rails();

    ESP_LOGW(TAG,
             "TEST6B entering TRUE ESP32-P4 Deep-sleep now. "
             "Compare final plateau with ~=41.6 mA vs ~=61.2 mA.");

    fflush(stdout);
    detach_uart0();
    vTaskDelay(pdMS_TO_TICKS(UART_QUIET_MS));
    esp_deep_sleep_start();
}
