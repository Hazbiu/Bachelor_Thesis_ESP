#include <stdio.h>

#include "config/app_config.h"
#include "driver/gpio.h"
#include "esp_check.h"
#include "esp_err.h"
#include "esp_log.h"
#include "esp_sleep.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

static const char *TAG = "RAW_DPI_DS_TEST";

#define BASELINE_MS              2000U
#define ACTIVE_MS                3000U
#define POST_STOP_MS             3000U
#define PRE_SLEEP_MS            10000U
#define UART_QUIET_MS             500U

extern esp_err_t bsp_test11_raw_dpi_start(void);
extern esp_err_t bsp_test11_raw_dpi_stop(void);

static int wait_level(gpio_num_t pin, int expected)
{
    for (unsigned i = 0; i < 20; ++i) {
        int level = gpio_get_level(pin);
        if (level == expected) return level;
        vTaskDelay(pdMS_TO_TICKS(10));
    }
    return gpio_get_level(pin);
}

static esp_err_t held_output(gpio_num_t pin, int level,
                             gpio_pullup_t pu, gpio_pulldown_t pd,
                             const char *name)
{
    esp_err_t ret = gpio_hold_dis(pin);
    if (ret != ESP_OK && ret != ESP_ERR_NOT_SUPPORTED) {
        ESP_LOGW(TAG, "%s hold release -> %s", name, esp_err_to_name(ret));
    }

    const gpio_config_t cfg = {
        .pin_bit_mask = 1ULL << pin,
        .mode = GPIO_MODE_INPUT_OUTPUT,
        .pull_up_en = pu,
        .pull_down_en = pd,
        .intr_type = GPIO_INTR_DISABLE,
    };

    ESP_RETURN_ON_ERROR(gpio_config(&cfg), TAG, "%s config failed", name);
    ESP_RETURN_ON_ERROR(gpio_set_level(pin, level), TAG, "%s level failed", name);
    ESP_RETURN_ON_ERROR(gpio_sleep_sel_dis(pin), TAG, "%s sleep_sel failed", name);
    ESP_RETURN_ON_ERROR(gpio_hold_en(pin), TAG, "%s hold failed", name);

    int rb = wait_level(pin, level);
    ESP_LOGI(TAG, "%s: GPIO%d=%d expected=%d hold=ON",
             name, (int)pin, rb, level);
    return rb == level ? ESP_OK : ESP_ERR_INVALID_STATE;
}

static esp_err_t float_input_no_pull(gpio_num_t pin)
{
    esp_err_t ret = gpio_hold_dis(pin);
    if (ret != ESP_OK && ret != ESP_ERR_NOT_SUPPORTED) {
        ESP_LOGW(TAG, "GPIO%d hold release -> %s",
                 (int)pin, esp_err_to_name(ret));
    }

    const gpio_config_t cfg = {
        .pin_bit_mask = 1ULL << pin,
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_DISABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };
    ESP_RETURN_ON_ERROR(gpio_config(&cfg), TAG, "GPIO%d config failed", (int)pin);
    return gpio_sleep_sel_dis(pin);
}

static void quiesce_rails(void)
{
    ESP_ERROR_CHECK(held_output(APP_PWR_WIFI_C6_CHIP_PU_GPIO,
                                APP_PWR_WIFI_C6_DISABLED_LEVEL,
                                GPIO_PULLUP_DISABLE, GPIO_PULLDOWN_ENABLE,
                                "ESP32-C6 CHIP_PU"));
    ESP_ERROR_CHECK(held_output(APP_PWR_ETHERNET_PHY_RESET_GPIO,
                                APP_PWR_ETHERNET_RESET_ACTIVE_LEVEL,
                                GPIO_PULLUP_DISABLE, GPIO_PULLDOWN_DISABLE,
                                "Ethernet PHY RESET"));
    ESP_ERROR_CHECK(held_output(APP_PWR_AUDIO_AMP_GPIO,
                                APP_PWR_AUDIO_AMP_DISABLED_LEVEL,
                                GPIO_PULLUP_DISABLE, GPIO_PULLDOWN_DISABLE,
                                "NS4150B amplifier EN"));
    ESP_ERROR_CHECK(held_output(APP_PWR_SDCARD_POWER_GPIO,
                                APP_PWR_SDCARD_POWER_OFF_LEVEL,
                                GPIO_PULLUP_DISABLE, GPIO_PULLDOWN_DISABLE,
                                "microSD power gate"));
}

static void release_unused(void)
{
#if APP_PWR_ISOLATE_SDMMC_PINS
    static const int sdmmc_pins[] = APP_PWR_SDMMC_PIN_LIST;
    for (size_t i = 0; i < sizeof(sdmmc_pins)/sizeof(sdmmc_pins[0]); ++i) {
        ESP_ERROR_CHECK(float_input_no_pull((gpio_num_t)sdmmc_pins[i]));
    }
#endif

    ESP_ERROR_CHECK(float_input_no_pull(APP_PWR_SHARED_I2C_SDA_GPIO));
    ESP_ERROR_CHECK(float_input_no_pull(APP_PWR_SHARED_I2C_SCL_GPIO));

#if APP_PWR_QUIESCE_PERIPHERAL_SIGNAL_PINS
    static const int pins[] = APP_PWR_PERIPHERAL_SIGNAL_PIN_LIST;
    for (size_t i = 0; i < sizeof(pins)/sizeof(pins[0]); ++i) {
        ESP_ERROR_CHECK(float_input_no_pull((gpio_num_t)pins[i]));
    }
#endif
}

static void configure_gpio3_wake(void)
{
    const gpio_num_t pin = APP_DEEP_SLEEP_BUTTON_GPIO;
    const gpio_config_t cfg = {
        .pin_bit_mask = 1ULL << pin,
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };
    ESP_ERROR_CHECK(gpio_config(&cfg));

    while (gpio_get_level(pin) == 0) {
        ESP_LOGW(TAG, "Release GPIO%d wake button", (int)pin);
        vTaskDelay(pdMS_TO_TICKS(100));
    }

    esp_err_t ret = esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_ALL);
    if (ret != ESP_OK && ret != ESP_ERR_INVALID_STATE) {
        ESP_ERROR_CHECK(ret);
    }

    ESP_ERROR_CHECK(esp_deep_sleep_enable_gpio_wakeup(
        1ULL << pin, ESP_GPIO_WAKEUP_GPIO_LOW));

    ESP_LOGI(TAG, "GPIO%d configured as ONLY Deep-sleep wake source", (int)pin);
}

static void detach_uart0(void)
{
#if APP_PWR_FLOAT_UART0_AT_FINAL_BOUNDARY
    static const int uart_pins[] = APP_PWR_UART0_PIN_LIST;
    for (size_t i = 0; i < sizeof(uart_pins)/sizeof(uart_pins[0]); ++i) {
        (void)float_input_no_pull((gpio_num_t)uart_pins[i]);
    }
#endif
}

void app_main(void)
{
    ESP_LOGW(TAG, "======================================================");
    ESP_LOGW(TAG, " TEST 11: RAW MIPI DPI CREATE ONLY");
    ESP_LOGW(TAG, " DPHY + DSI + DBI + RAW DPI");
    ESP_LOGW(TAG, " NO JD9365 DRIVER; NO 0x45 I2C; NO RESET/INIT");
    ESP_LOGW(TAG, " NO LVGL; NO GT911; NO BSP BRIGHTNESS");
    ESP_LOGW(TAG, "======================================================");

    quiesce_rails();

    ESP_LOGW(TAG, "TEST11 BASELINE window: %u ms", (unsigned)BASELINE_MS);
    vTaskDelay(pdMS_TO_TICKS(BASELINE_MS));

    ESP_LOGW(TAG, "TEST11 PHASE A: create DPHY+DSI+DBI+RAW DPI ONLY");
    ESP_ERROR_CHECK(bsp_test11_raw_dpi_start());

    ESP_LOGW(TAG,
             "TEST11 VERIFIED ACTIVE: RAW DPI panel exists; "
             "NO JD9365 constructor, NO controller I2C, NO reset/init");
    vTaskDelay(pdMS_TO_TICKS(ACTIVE_MS));

    ESP_LOGW(TAG, "TEST11 PHASE B: delete RAW DPI+DBI+DSI and release DPHY");
    ESP_ERROR_CHECK(bsp_test11_raw_dpi_stop());

    ESP_LOGW(TAG,
             "TEST11 VERIFIED STOPPED: DPI/DBI/DSI deleted; DPHY released");
    vTaskDelay(pdMS_TO_TICKS(POST_STOP_MS));

    quiesce_rails();
    release_unused();
    configure_gpio3_wake();

    ESP_LOGW(TAG, "TEST11 PRE-SLEEP measurement window: %u ms",
             (unsigned)PRE_SLEEP_MS);
    vTaskDelay(pdMS_TO_TICKS(PRE_SLEEP_MS));

    quiesce_rails();

    ESP_LOGW(TAG,
             "TEST11 entering TRUE ESP32-P4 Deep-sleep now. "
             "Compare with Test9 ~=41.65 mA and Test10 ~=68.12 mA.");

    fflush(stdout);
    detach_uart0();
    vTaskDelay(pdMS_TO_TICKS(UART_QUIET_MS));
    esp_deep_sleep_start();
}
