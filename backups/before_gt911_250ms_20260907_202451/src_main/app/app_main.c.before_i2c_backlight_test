/*
 * TEST 3: RAW JD9365 + MIPI-DSI HISTORY
 *          NO LVGL ADAPTER, NO GT911 TOUCH
 * ============================================================
 *
 * This is the clean split after Test 2.
 *
 * TEST 2 still used:
 *     esp_lv_adapter_init()
 *     esp_lv_adapter_register_display()
 *     LVGL bridge/display resources
 *
 * TEST 3 does NOT call display_platform_start() or bsp_display_start().
 *
 * Instead it calls the lower-level BSP function:
 *
 *     bsp_display_new(NULL, &panel, &io)
 *
 * The Waveshare BSP implementation uses this path to:
 *     - initialize display-side I2C/brightness control
 *     - acquire the MIPI DPHY LDO
 *     - create the MIPI-DSI bus
 *     - create the DBI panel-I/O
 *     - create/reset/init the JD9365 panel
 *
 * It does NOT register an LVGL display and does NOT create GT911 touch.
 *
 * Shutdown:
 *     - backlight off
 *     - DISPLAY_OFF
 *     - SLEEP_IN
 *     - delete JD9365 panel
 *     - delete DBI I/O
 *     - call bsp_display_shutdown_for_deep_sleep()
 *
 * The last call sees no LVGL/touch/panel handle owned by the high-level
 * display stack, but it still owns the raw BSP DSI-bus and DPHY-LDO state
 * created by bsp_display_new(), so it deletes/releases those remaining
 * low-level resources.
 */

static const char *TAG = "RAW_LCD_DS_TEST";

#define LCD_ACTIVE_SETTLE_MS  2000U
#define PRE_SLEEP_MEASURE_MS 10000U
#define UART_QUIET_MS          500U

static int wait_for_level(gpio_num_t pin, int expected)
{
    for (unsigned i = 0; i < 20U; ++i) {
        const int level = gpio_get_level(pin);
        if (level == expected) {
            return level;
        }
        vTaskDelay(pdMS_TO_TICKS(10));
    }
    return gpio_get_level(pin);
}

static esp_err_t held_output(
    gpio_num_t pin,
    int level,
    gpio_pullup_t pull_up,
    gpio_pulldown_t pull_down,
    const char *name)
{
    esp_err_t ret = gpio_hold_dis(pin);
    if (ret != ESP_OK && ret != ESP_ERR_NOT_SUPPORTED) {
        ESP_LOGW(TAG, "%s: previous hold release on GPIO%d returned %s",
                 name, (int)pin, esp_err_to_name(ret));
    }

    const gpio_config_t cfg = {
        .pin_bit_mask = 1ULL << pin,
        .mode = GPIO_MODE_INPUT_OUTPUT,
        .pull_up_en = pull_up,
        .pull_down_en = pull_down,
        .intr_type = GPIO_INTR_DISABLE,
    };

    ret = gpio_config(&cfg);
    if (ret != ESP_OK) {
        return ret;
    }

    ret = gpio_set_level(pin, level);
    if (ret != ESP_OK) {
        return ret;
    }

    ret = gpio_sleep_sel_dis(pin);
    if (ret != ESP_OK) {
        return ret;
    }

    ret = gpio_hold_en(pin);
    if (ret != ESP_OK) {
        return ret;
    }

    const int readback = wait_for_level(pin, level);
    ESP_LOGI(TAG, "%s: GPIO%d=%d expected=%d hold=ON",
             name, (int)pin, readback, level);

    return readback == level ? ESP_OK : ESP_ERR_INVALID_STATE;
}

static esp_err_t float_input_no_pull(gpio_num_t pin)
{
    esp_err_t ret = gpio_hold_dis(pin);
    if (ret != ESP_OK && ret != ESP_ERR_NOT_SUPPORTED) {
        ESP_LOGW(TAG, "GPIO%d previous hold release returned %s",
                 (int)pin, esp_err_to_name(ret));
    }

    const gpio_config_t cfg = {
        .pin_bit_mask = 1ULL << pin,
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_DISABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };

    ret = gpio_config(&cfg);
    if (ret != ESP_OK) {
        return ret;
    }

    return gpio_sleep_sel_dis(pin);
}

static void quiesce_board_control_rails(void)
{
    ESP_ERROR_CHECK(held_output(
        APP_PWR_WIFI_C6_CHIP_PU_GPIO,
        APP_PWR_WIFI_C6_DISABLED_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_ENABLE,
        "ESP32-C6 CHIP_PU"));

    ESP_ERROR_CHECK(held_output(
        APP_PWR_ETHERNET_PHY_RESET_GPIO,
        APP_PWR_ETHERNET_RESET_ACTIVE_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_DISABLE,
        "Ethernet PHY RESET"));

    ESP_ERROR_CHECK(held_output(
        APP_PWR_AUDIO_AMP_GPIO,
        APP_PWR_AUDIO_AMP_DISABLED_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_DISABLE,
        "NS4150B amplifier EN"));

    ESP_ERROR_CHECK(held_output(
        APP_PWR_SDCARD_POWER_GPIO,
        APP_PWR_SDCARD_POWER_OFF_LEVEL,
        GPIO_PULLUP_DISABLE,
        GPIO_PULLDOWN_DISABLE,
        "microSD power gate"));
}

static void release_unused_signal_pins(void)
{
#if APP_PWR_ISOLATE_SDMMC_PINS
    static const int sdmmc_pins[] = APP_PWR_SDMMC_PIN_LIST;
    for (size_t i = 0; i < sizeof(sdmmc_pins) / sizeof(sdmmc_pins[0]); ++i) {
        ESP_ERROR_CHECK(float_input_no_pull((gpio_num_t)sdmmc_pins[i]));
    }
#endif

    ESP_ERROR_CHECK(float_input_no_pull(APP_PWR_SHARED_I2C_SDA_GPIO));
    ESP_ERROR_CHECK(float_input_no_pull(APP_PWR_SHARED_I2C_SCL_GPIO));

#if APP_PWR_QUIESCE_PERIPHERAL_SIGNAL_PINS
    static const int peripheral_pins[] = APP_PWR_PERIPHERAL_SIGNAL_PIN_LIST;
    for (size_t i = 0;
         i < sizeof(peripheral_pins) / sizeof(peripheral_pins[0]);
         ++i) {
        ESP_ERROR_CHECK(float_input_no_pull((gpio_num_t)peripheral_pins[i]));
    }
#endif
}

static void configure_gpio3_only_wakeup(void)
{
    const gpio_num_t wake_pin = APP_DEEP_SLEEP_BUTTON_GPIO;

    const gpio_config_t wake_cfg = {
        .pin_bit_mask = 1ULL << wake_pin,
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };
    ESP_ERROR_CHECK(gpio_config(&wake_cfg));

    if (!esp_sleep_is_valid_wakeup_gpio(wake_pin)) {
        ESP_LOGE(TAG, "GPIO%d is not valid for Deep-sleep wake", (int)wake_pin);
        ESP_ERROR_CHECK(ESP_ERR_INVALID_ARG);
    }

    while (gpio_get_level(wake_pin) == 0) {
        ESP_LOGW(TAG, "Release GPIO%d wake button to continue", (int)wake_pin);
        vTaskDelay(pdMS_TO_TICKS(100));
    }

    const esp_err_t clear_ret =
        esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_ALL);
    if (clear_ret != ESP_OK && clear_ret != ESP_ERR_INVALID_STATE) {
        ESP_ERROR_CHECK(clear_ret);
    }

    ESP_ERROR_CHECK(
        esp_deep_sleep_enable_gpio_wakeup(
            1ULL << wake_pin,
            ESP_GPIO_WAKEUP_GPIO_LOW));

    ESP_LOGI(TAG, "GPIO%d configured as the ONLY Deep-sleep wake source",
             (int)wake_pin);
}

static void detach_uart0(void)
{
#if APP_PWR_FLOAT_UART0_AT_FINAL_BOUNDARY
    static const int uart0_pins[] = APP_PWR_UART0_PIN_LIST;
    for (size_t i = 0; i < sizeof(uart0_pins) / sizeof(uart0_pins[0]); ++i) {
        (void)float_input_no_pull((gpio_num_t)uart0_pins[i]);
    }
#endif
}

static void run_raw_lcd_mipi_history_test(void)
{
    esp_lcd_panel_handle_t panel = NULL;
    esp_lcd_panel_io_handle_t io = NULL;

    ESP_LOGW(
        TAG,
        "TEST3 PHASE A: RAW bsp_display_new(); NO LVGL adapter, NO GT911");

    const esp_err_t start_ret = bsp_display_new(NULL, &panel, &io);
    if (start_ret != ESP_OK || panel == NULL || io == NULL) {
        ESP_LOGE(
            TAG,
            "Raw LCD/MIPI initialization failed: ret=%s panel=%p io=%p",
            esp_err_to_name(start_ret),
            (void *)panel,
            (void *)io);
        ESP_ERROR_CHECK(start_ret != ESP_OK ? start_ret : ESP_FAIL);
    }

    ESP_LOGW(
        TAG,
        "TEST3 VERIFIED: raw JD9365/MIPI handles exist; "
        "LVGL and GT911 initialization were never called");

    ESP_ERROR_CHECK(bsp_display_backlight_on());

    ESP_LOGW(
        TAG,
        "TEST3 RAW-LCD-ACTIVE window: %u ms",
        (unsigned)LCD_ACTIVE_SETTLE_MS);
    vTaskDelay(pdMS_TO_TICKS(LCD_ACTIVE_SETTLE_MS));

    ESP_LOGW(TAG, "TEST3 PHASE B: backlight OFF + DISPLAY_OFF");
    const esp_err_t backlight_ret = bsp_display_backlight_off();
    ESP_LOGI(TAG, "backlight off result=%s", esp_err_to_name(backlight_ret));

    const esp_err_t display_off_ret =
        esp_lcd_panel_disp_on_off(panel, false);
    ESP_LOGI(TAG, "DISPLAY_OFF result=%s", esp_err_to_name(display_off_ret));

    vTaskDelay(pdMS_TO_TICKS(20));

    ESP_LOGW(TAG, "TEST3 PHASE C: JD9365 SLEEP_IN");
    const esp_err_t sleep_ret =
        esp_lcd_panel_disp_sleep(panel, true);
    ESP_LOGI(TAG, "SLEEP_IN result=%s", esp_err_to_name(sleep_ret));

    /*
     * Keep the same type of panel-sleep settling margin used by the board
     * shutdown implementation before destroying the transport.
     */
    vTaskDelay(pdMS_TO_TICKS(120));

    ESP_LOGW(TAG, "TEST3 PHASE D: delete raw JD9365 panel + DBI I/O");

    esp_err_t panel_del_ret = esp_lcd_panel_del(panel);
    ESP_LOGI(TAG, "panel delete result=%s", esp_err_to_name(panel_del_ret));
    if (panel_del_ret == ESP_OK) {
        panel = NULL;
    }

    esp_err_t io_del_ret = ESP_OK;
    if (panel == NULL) {
        io_del_ret = esp_lcd_panel_io_del(io);
        ESP_LOGI(TAG, "DBI I/O delete result=%s", esp_err_to_name(io_del_ret));
        if (io_del_ret == ESP_OK) {
            io = NULL;
        }
    } else {
        io_del_ret = ESP_ERR_INVALID_STATE;
        ESP_LOGW(TAG, "DBI I/O kept because panel deletion failed");
    }

    /*
     * bsp_display_new() leaves the BSP's raw MIPI-DSI bus and DPHY-LDO handles
     * tracked internally.  No LVGL adapter/touch/global high-level panel handles
     * were created in this test.  Therefore the normal BSP deep-sleep shutdown
     * can now clean just those remaining low-level resources.
     */
    ESP_LOGW(
        TAG,
        "TEST3 PHASE E: delete BSP MIPI-DSI bus + release DPHY 2.5-V LDO");

    const esp_err_t low_level_ret =
        bsp_display_shutdown_for_deep_sleep();
    ESP_LOGI(
        TAG,
        "remaining BSP display-resource cleanup result=%s",
        esp_err_to_name(low_level_ret));

    if (backlight_ret != ESP_OK ||
        display_off_ret != ESP_OK ||
        sleep_ret != ESP_OK ||
        panel_del_ret != ESP_OK ||
        io_del_ret != ESP_OK ||
        low_level_ret != ESP_OK) {
        ESP_LOGW(
            TAG,
            "One or more raw LCD shutdown operations reported an error; "
            "continuing to true Deep-sleep so the electrical result is visible");
    }
}

void app_main(void)
{
    ESP_LOGW(TAG, "======================================================");
    ESP_LOGW(TAG, " TEST 3: RAW JD9365 + MIPI-DSI, NO LVGL, NO GT911");
    ESP_LOGW(TAG, " Minimal baseline comparator ~= 41.6 mA");
    ESP_LOGW(TAG, " TEST2 comparator: LCD/MIPI/LVGL no-touch ~= 61.6 mA");
    ESP_LOGW(TAG, " Camera/AI/normal application are NOT started.");
    ESP_LOGW(TAG, "======================================================");

    quiesce_board_control_rails();

    run_raw_lcd_mipi_history_test();

    quiesce_board_control_rails();
    release_unused_signal_pins();
    configure_gpio3_only_wakeup();

    ESP_LOGW(
        TAG,
        "TEST3 PRE-SLEEP measurement window: %u ms after raw LCD/MIPI teardown",
        (unsigned)PRE_SLEEP_MEASURE_MS);

    vTaskDelay(pdMS_TO_TICKS(PRE_SLEEP_MEASURE_MS));

    quiesce_board_control_rails();

    ESP_LOGW(
        TAG,
        "TEST3 entering TRUE ESP32-P4 Deep-sleep now. "
        "Compare final plateau with minimal ~=41.6 mA and TEST2 ~=61.6 mA.");

    fflush(stdout);

    detach_uart0();

    vTaskDelay(pdMS_TO_TICKS(UART_QUIET_MS));
    esp_deep_sleep_start();
}
