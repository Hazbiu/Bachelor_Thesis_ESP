# Raw binary bridge: do not print application console text on UART0.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# Board under test: ESP32-P4 revision v1.3.
# ESP-IDF 5.5 defaults fresh P4 projects to minimum revision v3.1.
# Select the supported pre-v3 compatibility path instead.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
