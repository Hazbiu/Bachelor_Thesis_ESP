# Utility command for package

build esp-idf/main/CMakeFiles/package.util: CUSTOM_COMMAND esp-idf/main/all
  COMMAND = cd /home/hazbiu/Programming/Bachelor_Thesis_ESP/src/build && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

